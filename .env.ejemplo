# ===========================================================
#  Configuración de Ferretería Max
#  Al arrancar por primera vez, este archivo se copia a ".env".
#  Edite ".env" (no este) y reinicie el servidor.
# ===========================================================

# Puerto donde corre el sitio: http://localhost:3000
PUERTO=3000

# ---------- Súper administrador (cuenta secreta) ----------
# Se crea automáticamente la primera vez que arranca el servidor.
# OJO: si un valor lleva el símbolo #, escríbalo entre comillas
# (ej.: SUPERADMIN_CONTRASENA="Mi#Clave2026"), si no, lo que sigue al # se ignora.
SUPERADMIN_NOMBRE=Administración General
SUPERADMIN_CORREO=creador@ferreteriamax.cr
SUPERADMIN_CONTRASENA=Creador-Max-2026

# Ruta oculta para entrar como súper admin. No la comparta.
# Debe empezar con "/" y usar solo letras, números y guiones.
RUTA_SECRETA=/acceso-fm-8q3z

# Si olvida la contraseña del súper admin: ponga "si", reinicie
# el servidor (se restablece con SUPERADMIN_CONTRASENA) y vuelva a "no".
RESTABLECER_SUPERADMIN=no

# Duración de la sesión (días) para que el usuario quede logueado
DIAS_SESION=30

# ---------- Base de datos en la nube (opcional) ----------
# Si llena estas dos líneas, el sitio usa Turso (en internet) en vez
# del archivo datos/ferreteria.db. En Vercel se ponen en
# Settings > Environment Variables, no en este archivo.
# TURSO_DATABASE_URL=libsql://ferreteria-max-SU-USUARIO.turso.io
# TURSO_AUTH_TOKEN=
